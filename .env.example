# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# LLM API Keys (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Configuration (REQUIRED for pipeline only)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Upstash Redis (OPTIONAL — shared rate limiter, see lib/rate-limit.js).
# Free tier at upstash.com/redis. Without these, rate limiting falls back to
# an in-memory, per-instance limiter (works, but not shared across Vercel
# instances or durable across cold starts).
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
